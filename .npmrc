# 依赖布局：用 pnpm 默认的 isolated 硬链接仓（node_modules/.pnpm），
# 并**故意不开** shamefully-hoist / public-hoist-pattern。
#
# 为什么：pnpm 的默认布局是「半严格」的 —— 依赖之间能互相访问（生态兼容），
# 但应用代码只能访问自己 package.json 声明过的包。换句话说，
# **幽灵依赖会直接报 module not found，而不是静默白嫖成功**。
# 本项目踩过一次：主进程 import 'express' 从未声明，靠 hoisting 侥幸跑通，
# 直到依赖图变动才暴露。关掉提升 = 把这类问题从「运行时炸弹」变成「安装后立刻报错」。
#
# 对比（这是安装慢的根因，已弃用）：
#   node-linker=hoisted  = 把 ~800 个包物理铺平成 33k+ 真实文件，Windows 上落盘 + 杀软扫描极慢
#   shamefully-hoist=true = 等价于 public-hoist-pattern=*，安装快但幽灵依赖全都复活
#
# 若将来确有个别工具必须读根 node_modules（如某些插件按固定路径找 peer），
# 只给它开精确白名单，不要整体提升：
#   public-hoist-pattern[]=vue
#
# 注意：hoist-pattern（默认 ['*']）提升到 node_modules/.pnpm/node_modules 隐藏目录，
# 应用代码访问不到，不产生幽灵依赖，不要动它。

# 工作区内部包一律走本地软链，不回落 registry。
# 这两项在 pnpm 10 起默认值都是 false（已从 pnpm 本体默认值表核实），显式打开更稳。
link-workspace-packages=true
prefer-workspace-packages=true

# ------------------------------------------------------------------ registry
# 走 npmmirror：实测同一请求 npmjs 2.5~4s 且间歇性抽风（install 日志里出现过
# 单次 42s、ECONNRESET 重试），npmmirror 稳定 1.7s 左右，不抽风。
# 下面两条 Electron 镜像本来也是 npmmirror 的，三者同源，保持一致。
# tarball 的 integrity 是内容哈希，换源不会让 lockfile 失效。
registry=https://registry.npmmirror.com/

# 下面两条是给 Electron 的安装脚本和 electron-builder 读的，必须留在 .npmrc ——
# 它们不走 pnpm 的配置体系，pnpm-workspace.yaml 里写无效。
electron_mirror=https://npmmirror.com/mirrors/electron/
electron_builder_binaries_mirror=https://npmmirror.com/mirrors/electron-builder-binaries/

# 以下设置实测已是 pnpm 10.33 的默认值，无需显式写出（写出来反而误导）：
#   node-linker               = isolated                      （shamefully-hoist 依赖它，勿再覆盖）
#   enable-pre-post-scripts   = true                          （根的 preinstall/postinstall 会执行）
#   strict-peer-dependencies  = false
#   auto-install-peers        = true
#   dedupe-peer-dependents    = true
