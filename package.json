{
  "name": "metatune-player",
  "version": "1.0.0",
  "license": "MIT",
  "author": "gzj666-scy",
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:style": "stylelint \"**/*.{css,scss,vue}\"",
    "lint:style:fix": "stylelint \"**/*.{css,scss,vue}\" --fix",
    "type-check": "pnpm -r type-check",
    "check": "pnpm format:check && pnpm lint && pnpm lint:style && pnpm type-check",
    "preinstall": "npx -y only-allow pnpm",
    "postinstall": "node scripts/sort-pkg.cjs \"**/package.json\" --ignore \"**/node_modules/**\" --ignore \"apps/mobile\""
  },
  "dependencies": {},
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^24.12.0",
    "eslint": "^10.2.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsonc": "^3.4.2",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.12.0",
    "postcss": "^8.5.28",
    "postcss-html": "^2.0.0",
    "postcss-scss": "^4.0.9",
    "prettier": "^3.8.2",
    "sass": "^1.99.0",
    "sort-package-json": "^4.0.0",
    "stylelint": "^16.26.1",
    "stylelint-config-html": "^2.0.0",
    "stylelint-config-recommended-vue": "^2.0.0",
    "stylelint-config-standard": "^36.0.1",
    "stylelint-config-standard-scss": "^14.0.0",
    "stylelint-config-standard-vue": "^2.0.0",
    "terser": "^5.46.1",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.70.1",
    "vue-tsc": "^3.3.11"
  },
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20.19.0",
    "pnpm": ">=9.0.0"
  }
}
